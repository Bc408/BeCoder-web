---
import DownloadLink from './DownloadLink.astro';

const base = import.meta.env.BASE_URL;
---

<main id="product" class="hero">
  <section class="page-shell hero-content">
    <div class="hero-copy enter">
      <h1><b>BeCoder</b><span>专注竞赛编程的编辑器</span></h1>
      <p class="hero-description">一切就绪。BeCoder 把代码编辑、GCC 编译器、clangd、代码诊断与专用 Runner 都准备好了，让第一次写 C/C++ 的你，也能直接走向下一道题。</p>
      <div class="hero-actions"><DownloadLink label="下载 Windows 版" showWindowsMark /><a class="text-link" href="#why-becoder">了解 BeCoder <span aria-hidden="true">↓</span></a></div>
    </div>
    <div class="hero-product enter" style="animation-delay: 100ms">
      <div class="hero-gradient-floor" aria-hidden="true"></div>
      <div class="hero-screenshot-shell">
        <div class="editor-hero-screenshot"><img src={`${base}screenshots/editor-runner.png`} alt="BeCoder 编辑器中的 C++ 文件与 BeCoder Runner 输出" width="1902" height="1386" /><span class="editor-hero-cursor" aria-hidden="true"></span></div>
      </div>
    </div>
  </section>
</main>
