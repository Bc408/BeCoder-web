---
import ScreenshotFrame from './ScreenshotFrame.astro';
import SectionIntro from './SectionIntro.astro';
import { helpers } from '../content/site';
const base = import.meta.env.BASE_URL;
---

<section id="helpers" class="section section-surface"><div class="page-shell helpers-showcase"><SectionIntro eyebrow="BEYOND C/C++" title="为了写题与记录，刚好够用" description="Markdown、Mermaid 与 CodeSnap 帮你整理题解、笔记和代码片段；它们始终服务于 C/C++、GCC 诊断与 Runner 构成的核心工作流。" /><ScreenshotFrame label="MARKDOWN / MERMAID / CODESNAP" title="辅助能力" description="真实 BeCoder Markdown 预览、Mermaid 图表、C++ 编辑器与 Runner。" imageSrc={`${base}screenshots/beyond-cpp.png`} imageWebpSrcset={`${base}screenshots/optimized/beyond-cpp-768.webp 768w, ${base}screenshots/optimized/beyond-cpp-1280.webp 1280w, ${base}screenshots/optimized/beyond-cpp-2576.webp 2576w`} imageSizes="(max-width: 640px) calc(100vw - 64px), (max-width: 1240px) calc(100vw - 80px), 1200px" imageAlt="BeCoder 中的 C++ 编辑器、input 文件、Markdown 预览、Mermaid 流程图与 Runner 输出" imageWidth={2576} imageHeight={1516} priority="primary" /><ul class="compact-list">{helpers.map(([name, description]) => <li><strong>{name}</strong><span>{description}</span></li>)}</ul></div></section>
