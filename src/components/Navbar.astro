---
import { navigation } from '../content/navigation';
import { product } from '../content/product';

const base = import.meta.env.BASE_URL;
---

<header class="sticky top-0 z-20 border-b border-graphite/80 bg-void/90 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-[1200px] items-center justify-between px-5 lg:px-6" aria-label="Main navigation">
    <a class="flex items-center gap-2 text-[15px] font-medium text-white" href={base} aria-label="BeCoder home">
      <img class="h-7 w-7" src={`${base}brand/becoder-colored.svg`} alt="" width="28" height="28" />
      <span>BeCoder</span>
    </a>
    <div class="hidden items-center gap-1 md:flex">
      {navigation.map((item) => (
        <a
          class="rounded-md px-3 py-2 text-[13px] text-mist transition-colors hover:text-white"
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noreferrer' : undefined}
        >
          {item.label}
        </a>
      ))}
    </div>
    <a
      class="rounded-md bg-lime px-4 py-2 text-[13px] font-medium text-void transition-transform hover:-translate-y-px"
      href={product.releaseUrl}
    >
      下载
    </a>
  </nav>
</header>
