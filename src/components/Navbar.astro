---
import DownloadLink from './DownloadLink.astro';
import { navigation } from '../content/navigation';

const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <nav class="page-shell nav" aria-label="主导航">
    <a class="brand" href={base} aria-label="BeCoder 首页"><img src={`${base}brand/becoder-colored.svg`} alt="" width="28" height="28" /><span>BeCoder</span><small>C/C++ COMPETITIVE PROGRAMMING FOCUSED</small></a>
    <div class="nav-links">
      {navigation.map((item) => <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noreferrer' : undefined}>{item.label}</a>)}
    </div>
    <DownloadLink class="nav-download" label="下载" />
  </nav>
</header>
