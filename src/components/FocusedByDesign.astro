---
import SectionIntro from './SectionIntro.astro';
import { excludedCapabilities, keptCapabilities } from '../content/site';
---

<section id="focus" class="section section-line"><div class="page-shell split-section"><SectionIntro eyebrow="FOCUSED BY DESIGN" title="专门的编辑器，不需要包揽一切" description="当 AI、Chat 与 Agent 不断挤进编辑器，代码、推导和一次次尝试反而容易被忽略。BeCoder 选择不把这些能力带进核心工作流，把注意力还给 coder 最开始的事：读题、思考、亲手写下每一行代码，再让 GCC、clangd 与 Runner 给出直接反馈。" /><div class="capability-columns"><article><p>保留能力 / KEPT</p><ul>{keptCapabilities.map((item) => <li>{item}</li>)}</ul></article><article><p>不作为产品能力</p><ul>{excludedCapabilities.map((item) => <li>{item}</li>)}</ul></article></div></div></section>
