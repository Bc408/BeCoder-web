---
interface Props {
  label: string;
  title: string;
  description: string;
  imageSrc?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  priority?: 'primary' | 'secondary';
}

const { label, title, description, imageSrc, imageAlt = '', imageWidth = 1902, imageHeight = 1386, priority = 'secondary' } = Astro.props;
---

<figure class:list={['screenshot-frame', priority === 'primary' && 'screenshot-frame-primary']}>
  {imageSrc ? (
    <img src={imageSrc} alt={imageAlt} width={imageWidth} height={imageHeight} loading="lazy" />
  ) : (
    <div class="screenshot-placeholder">
      <p>REAL BECODER SCREENSHOT</p>
      <div>
        <span>{label}</span>
        <h3>{title}</h3>
        <figcaption>{description}</figcaption>
      </div>
      <i aria-hidden="true"></i>
    </div>
  )}
</figure>
