---
interface Props { eyebrow?: string; title: string; description?: string; align?: 'left' | 'center'; }
const { eyebrow, title, description, align = 'left' } = Astro.props;
const alignment = align === 'center' ? 'mx-auto text-center' : '';
---
<div class:list={['max-w-2xl', alignment]}>
  {eyebrow && <p class="font-mono text-xs text-ash">{eyebrow}</p>}
  <h2 class="mt-4 text-3xl font-normal leading-[1.08] text-white sm:text-4xl">{title}</h2>
  {description && <p class="mt-5 text-base leading-7 text-mist sm:text-lg">{description}</p>}
</div>
