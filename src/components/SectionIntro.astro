---
interface Props {
  eyebrow: string;
  title: string;
  titleBreak?: string | false;
  description: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, titleBreak, description, align = 'left' } = Astro.props;
const commaIndex = title.search(/[,，]/);
const autoTitleBreak = commaIndex >= 0 ? title.slice(commaIndex + 1).trim() : undefined;
const titleFirstLine = titleBreak === false || commaIndex < 0 ? title : title.slice(0, commaIndex + 1);
const resolvedTitleBreak = titleBreak ?? autoTitleBreak;
---

<div class:list={['section-intro', align === 'center' && 'section-intro-center']}>
  <p class="eyebrow">{eyebrow}</p>
  <h2>{titleFirstLine}{resolvedTitleBreak && <><br />{resolvedTitleBreak}</>}</h2>
  <p class="section-description">{description}</p>
</div>
