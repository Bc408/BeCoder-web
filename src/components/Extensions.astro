---
import ScreenshotFrame from './ScreenshotFrame.astro';
import SectionIntro from './SectionIntro.astro';
import { extensions } from '../content/site';
const base = import.meta.env.BASE_URL;
---

<section id="extensions" class="section"><div class="page-shell feature-row"><SectionIntro eyebrow="EXTENSIONS" title="保持专注，仍然可以扩展" description="BeCoder 不把扩展能力关在门外：在线扩展统一来自 Open VSX，本地 VSIX 也可按需安装；核心 C/C++ 工作链仍保持受保护的产品边界。" /><div class="feature-side"><ScreenshotFrame label="OPEN VSX / VSIX" title="扩展搜索与安装" description="BeCoder 中的真实 Notebook 与 C++ 工作画面。" imageSrc={`${base}screenshots/extensions.png`} imageWebpSrcset={`${base}screenshots/optimized/extensions-768.webp 768w, ${base}screenshots/optimized/extensions-1280.webp 1280w, ${base}screenshots/optimized/extensions-1814.webp 1814w`} imageSizes="(max-width: 640px) calc(100vw - 64px), (max-width: 900px) calc(100vw - 80px), 620px" imageAlt="BeCoder 中的 Notebook、C++ 单元格与 GCC Runner 输出" imageWidth={1814} imageHeight={1268} /><ul class="compact-list">{extensions.map(([name, description]) => <li><strong>{name}</strong><span>{description}</span></li>)}</ul></div></div></section>
