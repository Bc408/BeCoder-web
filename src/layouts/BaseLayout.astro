---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'BeCoder',
  description = '面向竞赛编程的自包含 C/C++ 编辑器。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08090a" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}brand/favicon.ico`} sizes="any" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
